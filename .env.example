# Copie para .env.local e preencha. Nunca versione o .env.local.

# URL pública do site, sem barra no final. Usada no link do "Tenho interesse",
# no Open Graph, no sitemap e nos e-mails de redefinição de senha.
# Desenvolvimento: http://localhost:3000 · Produção: https://todecarro.com.br (TODO: domínio real)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase → Project Settings → API.
# URL do projeto.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave pública: "anon" (legada) ou "publishable" (sb_publishable_…). Vai para o navegador;
# o acesso é limitado pelas políticas de RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave secreta: "service_role" (legada) ou "secret" (sb_secret_…).
# SÓ NO SERVIDOR. Grava os formulários públicos e emite as URLs assinadas de upload.
# Nunca use prefixo NEXT_PUBLIC_ nesta variável.
SUPABASE_SERVICE_ROLE_KEY=

# Senha do banco definida ao criar o projeto no Supabase. Só para a CLI aplicar as migrations
# no seu computador (npm run db:push). Não precisa ir para a Vercel.
SUPABASE_DB_PASSWORD=

# Opcional: token pessoal da CLI (supabase.com/dashboard/account/tokens). Com ele, os comandos
# npm run db:* funcionam sem rodar "npx supabase login". Só no seu computador.
SUPABASE_ACCESS_TOKEN=

# Sal do hash do IP usado no limite de envios dos formulários públicos.
# Gere um valor aleatório longo (ex.: `openssl rand -hex 32`) e não o troque depois.
IP_HASH_SALT=

# Opcional: e-mail do usuário admin (o mesmo do npm run criar-admin). A entrada do painel pede só a
# senha com ou sem esta variável: sem ela, o e-mail vem do Supabase Auth (usuário com papel admin).
ADMIN_EMAIL=

# Segredo da limpeza diária (/api/limpeza, agendada no vercel.json para 03:00 de Brasília).
# A Vercel envia "Authorization: Bearer <CRON_SECRET>" sozinha quando a variável existe.
# Gere um valor aleatório longo (ex.: `openssl rand -hex 32`). Vai para a Vercel; local, só para testar.
CRON_SECRET=
